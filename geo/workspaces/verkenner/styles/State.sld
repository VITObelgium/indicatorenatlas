<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>State</sld:Name>
    <sld:UserStyle>
      <sld:Name>State</sld:Name>
      <sld:Title>State</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#6c6c6c" opacity="1" quantity="0" label="Overig"/>
              <sld:ColorMapEntry color="#cff5b8" opacity="1" quantity="1" label="Niet geregistreerd grasland met natuurwaarde"/>
              <sld:ColorMapEntry color="#f4f8bc" opacity="1" quantity="2" label="Niet geregistreerde landbouwgrond"/>
              <sld:ColorMapEntry color="#ececd2" opacity="1" quantity="3" label="Moeras zonder natuurbeheer"/>
              <sld:ColorMapEntry color="#ffeac1" opacity="1" quantity="4" label="Heide zonder natuurbeheer"/>
              <sld:ColorMapEntry color="#ead1ef" opacity="1" quantity="5" label="Kustduin zonder natuurbeheer"/>
              <sld:ColorMapEntry color="#a80000" opacity="1" quantity="6" label="Residentiele/commerciele bebouwing"/>
              <sld:ColorMapEntry color="#a87000" opacity="1" quantity="7" label="Agrarische bebouwing"/>
              <sld:ColorMapEntry color="#a900e6" opacity="1" quantity="8" label="Industrie"/>
              <sld:ColorMapEntry color="#73dfff" opacity="1" quantity="9" label="Zeehaven"/>
              <sld:ColorMapEntry color="#d7b09e" opacity="1" quantity="10" label="Luchthaven"/>
              <sld:ColorMapEntry color="#4c7300" opacity="1" quantity="11" label="Grasland met natuurbeheer"/>
              <sld:ColorMapEntry color="#70a800" opacity="1" quantity="12" label="Productiegrasland met natuur- en milieudoelen"/>
              <sld:ColorMapEntry color="#a5f57a" opacity="1" quantity="13" label="Productiegrasland"/>
              <sld:ColorMapEntry color="#cdcd66" opacity="1" quantity="14" label="Akker met natuurdoelen"/>
              <sld:ColorMapEntry color="#f5f57a" opacity="1" quantity="15" label="Akker met milieudoelen"/>
              <sld:ColorMapEntry color="#ffffbe" opacity="1" quantity="16" label="Akker"/>
              <sld:ColorMapEntry color="#267300" opacity="1" quantity="17" label="Bos met natuurbeheer"/>
              <sld:ColorMapEntry color="#38a800" opacity="1" quantity="18" label="Bos met bosbeheer"/>
              <sld:ColorMapEntry color="#d7d79e" opacity="1" quantity="19" label="Moeras met natuurbeheer"/>
              <sld:ColorMapEntry color="#ffd37f" opacity="1" quantity="20" label="Heide met natuurbeheer"/>
              <sld:ColorMapEntry color="#ffbee8" opacity="1" quantity="21" label="Kustduin met natuurbeheer"/>
              <sld:ColorMapEntry color="#00a884" opacity="1" quantity="22" label="Slik en schorre"/>
              <sld:ColorMapEntry color="#ff7f7f" opacity="1" quantity="23" label="Recreatie- en sportterrein"/>
              <sld:ColorMapEntry color="#ffaa00" opacity="1" quantity="24" label="Park"/>
              <sld:ColorMapEntry color="#ffff00" opacity="1" quantity="25" label="Militaire voorziening"/>
              <sld:ColorMapEntry color="#b2b2b2" opacity="1" quantity="26" label="Infrastructuur"/>
              <sld:ColorMapEntry color="#0070ff" opacity="1" quantity="27" label="Water"/>
              <sld:ColorMapEntry color="#ffffff" opacity="1" quantity="28" label="Buiten studiegebied"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

