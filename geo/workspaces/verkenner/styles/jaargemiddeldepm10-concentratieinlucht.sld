<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>jaargemiddeldepm10-concentratieinlucht</sld:Name>
    <sld:UserStyle>
      <sld:Name>jaargemiddeldepm10-concentratieinlucht</sld:Name>
      <sld:Title>jaargemiddeldepm10-concentratieinlucht</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="intervals">
              <sld:ColorMapEntry color="#FFFFFF" opacity="0" quantity="0" label="---"/>
              <sld:ColorMapEntry color="#0005FE" opacity="1" quantity="1000" label="0 - 10 µg/m³"/>
              <sld:ColorMapEntry color="#0080FC" opacity="1" quantity="1500" label="10 - 15 µg/m³"/>
              <sld:ColorMapEntry color="#02BF00" opacity="1" quantity="2000" label="15 - 20 µg/m³"/>
              <sld:ColorMapEntry color="#03FE00" opacity="1" quantity="2500" label="20 - 25 µg/m³"/>
              <sld:ColorMapEntry color="#CDFE33" opacity="1" quantity="3000" label="25 - 30 µg/m³"/>
              <sld:ColorMapEntry color="#F7E348" opacity="1" quantity="3500" label="30 - 35 µg/m³"/>
              <sld:ColorMapEntry color="#FE7D00" opacity="1" quantity="4000" label="35 - 40 µg/m³"/>
              <sld:ColorMapEntry color="#FE0000" opacity="1" quantity="4500" label="40 - 45 µg/m³"/>
              <sld:ColorMapEntry color="#BF0000" opacity="1" quantity="5000" label="45 - 50 µg/m³"/>
              <sld:ColorMapEntry color="#7F0000" opacity="1" quantity="999999" label="&gt; 50 µg/m³"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

