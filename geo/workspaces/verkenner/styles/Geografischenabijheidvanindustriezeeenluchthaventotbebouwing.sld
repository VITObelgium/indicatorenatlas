              <sld:ColorMapEntry color="#b6ff00" opacity="1" quantity="0.75" label="0.50 ... 0.75"/>
              <sld:ColorMapEntry color="#d2ff00" opacity="1" quantity="1" label="0.75 ... 1.00"/>
              <sld:ColorMapEntry color="#eaff00" opacity="1" quantity="1.5" label="1.00 ... 1.50"/>
              <sld:ColorMapEntry color="#ffe51c" opacity="1" quantity="2" label="1.50 ... 2.00"/>
              <sld:ColorMapEntry color="#ffca25" opacity="1" quantity="2.5" label="2.00 ... 2.50"/>
              <sld:ColorMapEntry color="#ffaa2b" opacity="1" quantity="3" label="2.50 ... 3.00"/>
              <sld:ColorMapEntry color="#ff842b" opacity="1" quantity="4" label="3.00 ... 4.00"/>
              <sld:ColorMapEntry color="#ff0000" opacity="1" quantity="1.79769e+308" label="4.00 ... 5.00"/>
            </sld:ColorMap>
