<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>oppervlaktegraslandtypen</sld:Name>
    <sld:UserStyle>
      <sld:Name>oppervlaktegraslandtypen</sld:Name>
      <sld:Title>oppervlaktegraslandtypen</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#E6E600" opacity="1" quantity="12" label="grasland met milieu- en natuurdoelen"/>
              <sld:ColorMapEntry color="#A8A800" opacity="1" quantity="13" label="productie grasland"/>
              <sld:ColorMapEntry color="#732600" opacity="1" quantity="105" label="grasland met natuurbeheer - zuur"/>
              <sld:ColorMapEntry color="#267300" opacity="1" quantity="106" label="grasland met natuurbeheer - neutraal"/>
              <sld:ColorMapEntry color="#002673" opacity="1" quantity="107" label="grasland met natuurbeheer - kalk"/>
              <sld:ColorMapEntry color="#E64C00" opacity="1" quantity="108" label="grasland zonder natuurbeheer - zuur"/>
              <sld:ColorMapEntry color="#4CE600" opacity="1" quantity="109" label="grasland zonder natuurbeheer - neutraal"/>
              <sld:ColorMapEntry color="#00A9E6" opacity="1" quantity="110" label="grasland zonder natuurbeheer - kalk"/>
              <sld:ColorMapEntry color="#FFFF73" opacity="1" quantity="230" label="grasland op niet geregistreerde landbouwgrond"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

