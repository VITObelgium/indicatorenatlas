<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>Toegankelijkheidbebouwing</sld:Name>
    <sld:UserStyle>
      <sld:Name>Toegankelijkheidbebouwing</sld:Name>
      <sld:Title>Toegankelijkheidbebouwing</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="intervals">
              <sld:ColorMapEntry color="#FFFFFF" opacity="0" quantity="0" label="---"/>
              <sld:ColorMapEntry color="#00ff00" opacity="1" quantity="0.1" label="0.00 ... 0.10"/>
              <sld:ColorMapEntry color="#94ff00" opacity="1" quantity="0.2" label="0.10 ... 0.20"/>
              <sld:ColorMapEntry color="#bdff00" opacity="1" quantity="0.3" label="0.20 ... 0.30"/>
              <sld:ColorMapEntry color="#daff00" opacity="1" quantity="0.4" label="0.30 ... 0.40"/>
              <sld:ColorMapEntry color="#f4ff00" opacity="1" quantity="0.5" label="0.40 ... 0.50"/>
              <sld:ColorMapEntry color="#fff016" opacity="1" quantity="0.6" label="0.50 ... 0.60"/>
              <sld:ColorMapEntry color="#ffd323" opacity="1" quantity="0.7" label="0.60 ... 0.70"/>
              <sld:ColorMapEntry color="#ffb22a" opacity="1" quantity="0.8" label="0.70 ... 0.80"/>
              <sld:ColorMapEntry color="#ff872c" opacity="1" quantity="0.9" label="0.80 ... 0.90"/>
              <sld:ColorMapEntry color="#ff0000" opacity="1" quantity="1.79769e+308" label="0.90 ... 1.00"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

