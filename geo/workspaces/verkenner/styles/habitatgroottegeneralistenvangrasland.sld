<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>habitatgroottegeneralistenvangrasland</sld:Name>
    <sld:UserStyle>
      <sld:Name>habitatgroottegeneralistenvangrasland</sld:Name>
      <sld:Title>habitatgroottegeneralistenvangrasland</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="intervals">
              <sld:ColorMapEntry color="#FFFFFF" opacity="0" quantity="0" label="---"/>
              <sld:ColorMapEntry color="#008080" opacity="1" quantity="4.999" label="  &lt; 5ha"/>
              <sld:ColorMapEntry color="#99CCCC" opacity="1" quantity="49.99" label=" 5 - 50ha"/>
              <sld:ColorMapEntry color="#CCCC66" opacity="1" quantity="499.99" label="50 - 500ha"/>
              <sld:ColorMapEntry color="#996633" opacity="1" quantity="20000000" label="   &gt; 500ha"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

