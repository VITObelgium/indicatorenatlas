<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>oppervlaktebostypen</sld:Name>
    <sld:UserStyle>
      <sld:Name>oppervlaktebostypen</sld:Name>
      <sld:Title>oppervlaktebostypen</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#267300" opacity="1" quantity="17" label="loofbos met natuurbeheer"/>
              <sld:ColorMapEntry color="#732600" opacity="1" quantity="42" label="naaldbos met natuurbeheer"/>
              <sld:ColorMapEntry color="#FF5500" opacity="1" quantity="43" label="naaldbos met bosbeheer"/>
              <sld:ColorMapEntry color="#98E600" opacity="1" quantity="221" label="loofbos met bos- en natuurbeheer"/>
              <sld:ColorMapEntry color="#734C00" opacity="1" quantity="222" label="loofbos met bosbeheer"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

