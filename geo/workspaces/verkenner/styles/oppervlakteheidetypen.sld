<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>oppervlakteheidetypen</sld:Name>
    <sld:UserStyle>
      <sld:Name>oppervlakteheidetypen</sld:Name>
      <sld:Title>oppervlakteheidetypen</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#00734C" opacity="1" quantity="101" label="natte heide met natuurbeheer"/>
              <sld:ColorMapEntry color="#737300" opacity="1" quantity="102" label="droge heide met natuurbeheer"/>
              <sld:ColorMapEntry color="#00E6A9" opacity="1" quantity="103" label="natte heide zonder natuurbeheer"/>
              <sld:ColorMapEntry color="#E6E600" opacity="1" quantity="104" label="droge heide zonder natuurbeheer"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

