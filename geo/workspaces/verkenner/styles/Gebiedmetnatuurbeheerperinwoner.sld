<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>Gebiedmetnatuurbeheerperinwoner</sld:Name>
    <sld:UserStyle>
      <sld:Name>Gebiedmetnatuurbeheerperinwoner</sld:Name>
      <sld:Title>Gebiedmetnatuurbeheerperinwoner</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="intervals">
              <sld:ColorMapEntry color="#FFFFFF" opacity="0" quantity="0" label="---"/>
              <sld:ColorMapEntry color="#ff0000" opacity="1" quantity="5" label="0 ... 5"/>
              <sld:ColorMapEntry color="#ff9e2d" opacity="1" quantity="10" label="5 ... 10"/>
              <sld:ColorMapEntry color="#ffd323" opacity="1" quantity="50" label="10 ... 50"/>
              <sld:ColorMapEntry color="#fffe03" opacity="1" quantity="100" label="50 ... 100"/>
              <sld:ColorMapEntry color="#daff00" opacity="1" quantity="250" label="100 ... 250"/>
              <sld:ColorMapEntry color="#abff00" opacity="1" quantity="1000" label="250 ... 1000"/>
              <sld:ColorMapEntry color="#00ff00" opacity="1" quantity="1.79769e+308" label="1000 ... 2500"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

