<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>daggemiddeldepm10-concentratieindelucht</sld:Name>
    <sld:UserStyle>
      <sld:Name>daggemiddeldepm10-concentratieindelucht</sld:Name>
      <sld:Title>daggemiddeldepm10-concentratieindelucht</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="intervals">
              <sld:ColorMapEntry color="#FFFFFF" opacity="0" quantity="0" label="---"/>
              <sld:ColorMapEntry color="#0005FE" opacity="1" quantity="5.1" label="0 - 4 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#0080FC" opacity="1" quantity="10.1" label="5 - 9 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#02BF00" opacity="1" quantity="15.1" label="10 - 14 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#03FE00" opacity="1" quantity="20.1" label="15 - 19 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#CDFE33" opacity="1" quantity="25.1" label="20 - 25 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#F7E348" opacity="1" quantity="30.1" label="26 - 30 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#FE7D00" opacity="1" quantity="35.1" label="31 - 35 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#FE0000" opacity="1" quantity="50.1" label="36 - 50 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#BF0000" opacity="1" quantity="70.1" label="51 - 70 dagen &gt; 50 µg/m³"/>
              <sld:ColorMapEntry color="#7F0000" opacity="1" quantity="999999" label="&gt; 70 dagen &gt; 50 µg/m³"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

