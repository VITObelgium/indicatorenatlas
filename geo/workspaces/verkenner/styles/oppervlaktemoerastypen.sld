<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>oppervlaktemoerastypen</sld:Name>
    <sld:UserStyle>
      <sld:Name>oppervlaktemoerastypen</sld:Name>
      <sld:Title>oppervlaktemoerastypen</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#734C00" opacity="1" quantity="310" label="open moeras met natuurbeheer"/>
              <sld:ColorMapEntry color="#E69800" opacity="1" quantity="311" label="open moeras zonder natuurbeheer"/>
              <sld:ColorMapEntry color="#267300" opacity="1" quantity="312" label="moerasbos met natuurbeheer"/>
              <sld:ColorMapEntry color="#A03C00" opacity="1" quantity="313" label="moerasbos zonder natuuurbeheer"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

