<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>samenhanggroeneruimte</sld:Name>
    <sld:UserStyle>
      <sld:Name>samenhanggroeneruimte</sld:Name>
      <sld:Title>samenhanggroeneruimte</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="values">
              <sld:ColorMapEntry color="#FF8C00" opacity="1" quantity="1" label="Vertakking"/>
              <sld:ColorMapEntry color="#000000" opacity="1" quantity="3" label="Rand"/>
              <sld:ColorMapEntry color="#0000FF" opacity="1" quantity="5" label="Perforatie"/>
              <sld:ColorMapEntry color="#A03C00" opacity="1" quantity="9" label="Eiland"/>
              <sld:ColorMapEntry color="#00C800" opacity="1" quantity="17" label="Kern"/>
              <sld:ColorMapEntry color="#FF0000" opacity="1" quantity="33" label="Brug"/>
              <sld:ColorMapEntry color="#FF0000" opacity="1" quantity="35" label="Brug in rand"/>
              <sld:ColorMapEntry color="#FF0000" opacity="1" quantity="37" label="Brug in perforatie"/>
              <sld:ColorMapEntry color="#FFFF00" opacity="1" quantity="65" label="Loop"/>
              <sld:ColorMapEntry color="#FFFF00" opacity="1" quantity="67" label="Loop in rand"/>
              <sld:ColorMapEntry color="#FFFF00" opacity="1" quantity="69" label="Loop in perforatie"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

