<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>Bevolkingsdichtheid</sld:Name>
    <sld:UserStyle>
      <sld:Name>Bevolkingsdichtheid</sld:Name>
      <sld:Title>Bevolkingsdichtheid</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="intervals">
              <sld:ColorMapEntry color="#FFFFFF" opacity="0" quantity="0" label="---"/>
              <sld:ColorMapEntry color="#ffffc8" opacity="1" quantity="0.667278" label="0.00 ... 0.67"/>
              <sld:ColorMapEntry color="#7eff00" opacity="1" quantity="3.63473" label="0.67 ... 3.63"/>
              <sld:ColorMapEntry color="#fcff00" opacity="1" quantity="20.4807" label="3.63 ... 20.48"/>
              <sld:ColorMapEntry color="#ff8100" opacity="1" quantity="164.99" label="20.48 ... 164.99"/>
              <sld:ColorMapEntry color="#ff0000" opacity="1" quantity="1.79769e+308" label="164.99 ... 2138.00"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

