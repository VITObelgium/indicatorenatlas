<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>Openruimtenabijheidbereikbaarheid</sld:Name>
    <sld:UserStyle>
      <sld:Name>Openruimtenabijheidbereikbaarheid</sld:Name>
      <sld:Title>Openruimtenabijheidbereikbaarheid</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="intervals">
              <sld:ColorMapEntry color="#FFFFFF" opacity="0" quantity="0" label="---"/>
              <sld:ColorMapEntry color="#00ff00" opacity="1" quantity="1.04778" label="0.00 ... 1.05"/>
              <sld:ColorMapEntry color="#b6ff00" opacity="1" quantity="3.19339" label="1.05 ... 3.19"/>
              <sld:ColorMapEntry color="#d2ff00" opacity="1" quantity="7.58711" label="3.19 ... 7.59"/>
              <sld:ColorMapEntry color="#ffff00" opacity="1" quantity="16.5845" label="7.59 ... 16.58"/>
              <sld:ColorMapEntry color="#ffca25" opacity="1" quantity="35.0091" label="16.58 ... 35.01"/>
              <sld:ColorMapEntry color="#ffaa2b" opacity="1" quantity="72.7385" label="35.01 ... 72.74"/>
              <sld:ColorMapEntry color="#ff0000" opacity="1" quantity="1.79769e+308" label="72.74 ... 150.00"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

