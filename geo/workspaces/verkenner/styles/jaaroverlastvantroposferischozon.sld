<?xml version="1.0" encoding="UTF-8"?><sld:StyledLayerDescriptor xmlns="http://www.opengis.net/sld" xmlns:sld="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:gml="http://www.opengis.net/gml" version="1.0.0">
  <sld:NamedLayer>
    <sld:Name>jaaroverlastvantroposferischozon</sld:Name>
    <sld:UserStyle>
      <sld:Name>jaaroverlastvantroposferischozon</sld:Name>
      <sld:Title>jaaroverlastvantroposferischozon</sld:Title>
      <sld:Abstract>Not available</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Name>name</sld:Name>
        <sld:FeatureTypeName>Feature</sld:FeatureTypeName>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap type="intervals">
              <sld:ColorMapEntry color="#FFFFFF" opacity="0" quantity="0" label="---"/>
              <sld:ColorMapEntry color="#0005FE" opacity="1" quantity="250.1" label="0 - 250 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#0080FC" opacity="1" quantity="500.1" label="250 - 500 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#02BF00" opacity="1" quantity="1000.1" label="500 - 1000 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#03FE00" opacity="1" quantity="1500.1" label="1000 - 1500 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#CDFE33" opacity="1" quantity="3000.1" label="1500 - 2000 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#F7E348" opacity="1" quantity="4000.1" label="2000 - 3000 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#FE7D00" opacity="1" quantity="5800.1" label="3000 - 4000 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#FE0000" opacity="1" quantity="8000.1" label="4000 - 5800 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#BF0000" opacity="1" quantity="10000.1" label="5800 - 8000 (µg/m³).uren"/>
              <sld:ColorMapEntry color="#7F0000" opacity="1" quantity="9999999" label="&gt; 8000 (µg/m³).uren"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</sld:StyledLayerDescriptor>

